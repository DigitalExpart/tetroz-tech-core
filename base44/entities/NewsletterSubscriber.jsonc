{
  "name": "NewsletterSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "consent": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "default": "website"
    },
    "status": {
      "type": "string",
      "enum": [
        "subscribed",
        "unsubscribed"
      ],
      "default": "subscribed"
    }
  },
  "required": [
    "email",
    "consent"
  ]
}